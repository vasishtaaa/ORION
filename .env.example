# Optional market-data and AI providers. Never commit your real .env file.
ALPHA_VANTAGE_API_KEY=
GEMINI_API_KEY=

# The engine intentionally listens only on this computer by default.
ORION_HOST=127.0.0.1
# Comma-separated origins if you deliberately expose the HTTP service.
ORION_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
